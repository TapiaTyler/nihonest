// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`article component extraction markup > preserves practical en parent markup byte for byte 1`] = `"<div class="not-prose mt-4 space-y-4 text-slate-700"><p class="leading-8"><strong>Time:</strong> Japan uses Japan Standard Time (JST), UTC+9, without seasonal daylight-saving changes.</p><p class="leading-8"><strong>Money:</strong> The national currency is the Japanese yen (JPY), written ¥ or 円.</p><p class="leading-8"><strong>Measurements:</strong> Official and everyday measurements generally use metric units such as kilometres, metres, kilograms, litres, and Celsius.</p><p class="leading-8"><strong>Emergencies:</strong> Call 110 for urgent police response and 119 for fire, rescue, or ambulance. Read the <a class="font-semibold text-teal-900 underline" href="/articles/calling-police-fire-and-ambulance-services-in-japan">emergency-call guide</a> and prepare with the <a class="font-semibold text-teal-900 underline" href="/articles/preparing-for-disasters-and-evacuation-in-japan">disaster and evacuation guide</a>.</p></div>"`;

exports[`article component extraction markup > preserves practical ja parent markup byte for byte 1`] = `"<div class="not-prose mt-4 space-y-4 text-slate-700"><p class="leading-8"><strong>時刻：</strong>日本は日本標準時（JST、UTC+9）を使用し、季節による夏時間の変更はありません。</p><p class="leading-8"><strong>通貨：</strong>日本の通貨は日本円（JPY）で、記号は「¥」または「円」です。</p><p class="leading-8"><strong>単位：</strong>公的な場面と日常生活では、キロメートル、メートル、キログラム、リットル、摂氏などのメートル法が一般的です。</p><p class="leading-8"><strong>緊急時：</strong>警察への緊急通報は110番、火災・救助・救急車は119番です。<a class="font-semibold text-teal-900 underline" href="/articles/calling-police-fire-and-ambulance-services-in-japan">緊急通報のガイド</a>を読み、<a class="font-semibold text-teal-900 underline" href="/articles/preparing-for-disasters-and-evacuation-in-japan">災害・避難のガイド</a>で備えてください。</p></div>"`;

exports[`article component extraction markup > preserves tax en parent markup byte for byte 1`] = `"<div lang="en" class="mt-6 overflow-x-auto rounded-2xl border border-slate-200"><table class="min-w-full border-collapse text-left text-sm"><caption class="sr-only">Broad Japanese income-tax scope by tax-residence classification</caption><thead class="bg-slate-100 text-slate-950"><tr><th scope="col" class="min-w-56 px-4 py-3 font-semibold">Tax-residence classification</th><th scope="col" class="min-w-80 px-4 py-3 font-semibold">Broad taxable scope</th></tr></thead><tbody class="divide-y divide-slate-200 bg-white text-slate-700"><tr><th scope="row" class="px-4 py-3 font-medium text-slate-950">Resident other than a non-permanent resident</th><td class="px-4 py-3">Generally subject to Japanese income tax on worldwide income.</td></tr><tr><th scope="row" class="px-4 py-3 font-medium text-slate-950">Non-permanent resident</th><td class="px-4 py-3">Generally taxed on income other than foreign-source income, plus foreign-source income paid in Japan or treated as remitted to Japan.</td></tr><tr><th scope="row" class="px-4 py-3 font-medium text-slate-950">Non-resident</th><td class="px-4 py-3">Generally taxed on Japanese domestic-source income under the rules for that income.</td></tr></tbody></table></div>"`;

exports[`article component extraction markup > preserves tax ja parent markup byte for byte 1`] = `"<div lang="ja" class="mt-6 overflow-x-auto rounded-2xl border border-slate-200"><table class="min-w-full border-collapse text-left text-sm"><caption class="sr-only">税務上の居住者区分ごとの日本の所得税の一般的な課税範囲</caption><thead class="bg-slate-100 text-slate-950"><tr><th scope="col" class="min-w-56 px-4 py-3 font-semibold">税務上の居住者区分</th><th scope="col" class="min-w-80 px-4 py-3 font-semibold">一般的な課税範囲</th></tr></thead><tbody class="divide-y divide-slate-200 bg-white text-slate-700"><tr><th scope="row" class="px-4 py-3 font-medium text-slate-950">非永住者以外の居住者</th><td class="px-4 py-3">一般に、全世界所得について日本の所得税の対象となります。</td></tr><tr><th scope="row" class="px-4 py-3 font-medium text-slate-950">非永住者</th><td class="px-4 py-3">一般に、国外源泉所得以外の所得に加え、日本で支払われた、または日本へ送金されたものとして扱われる国外源泉所得が課税対象となります。</td></tr><tr><th scope="row" class="px-4 py-3 font-medium text-slate-950">非居住者</th><td class="px-4 py-3">一般に、国内源泉所得について、その所得に適用される規則に基づいて課税されます。</td></tr></tbody></table></div>"`;

exports[`article component extraction markup > preserves training en parent markup byte for byte 1`] = `"<div lang="en" class="mt-6 overflow-x-auto rounded-2xl border border-slate-200"><table class="min-w-full border-collapse text-left text-sm"><caption class="sr-only">Activities and the training, study, or work routes to examine first</caption><thead class="bg-slate-100 text-slate-950"><tr><th scope="col" class="min-w-64 px-4 py-3 font-semibold">Proposed activity</th><th scope="col" class="min-w-56 px-4 py-3 font-semibold">Route to examine first</th></tr></thead><tbody class="divide-y divide-slate-200 bg-white text-slate-700"><tr><th scope="row" class="px-4 py-3 font-medium text-slate-950">Unpaid Japanese cultural study or research</th><td class="px-4 py-3"><a href="/articles/cultural-activities-visa" class="font-medium text-teal-800 underline decoration-teal-300 underline-offset-4 hover:text-teal-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700">Cultural Activities</a></td></tr><tr><th scope="row" class="px-4 py-3 font-medium text-slate-950">Education at a qualifying school</th><td class="px-4 py-3"><a href="/articles/student-visa-and-certificate-of-eligibility" class="font-medium text-teal-800 underline decoration-teal-300 underline-offset-4 hover:text-teal-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700">Student</a></td></tr><tr><th scope="row" class="px-4 py-3 font-medium text-slate-950">Structured non-employment training through a host</th><td class="px-4 py-3"><a href="/articles/training-visa" class="font-medium text-teal-800 underline decoration-teal-300 underline-offset-4 hover:text-teal-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700">Training</a></td></tr><tr><th scope="row" class="px-4 py-3 font-medium text-slate-950">A current approved legacy technical-intern plan</th><td class="px-4 py-3"><a href="/articles/technical-intern-training-status" class="font-medium text-teal-800 underline decoration-teal-300 underline-offset-4 hover:text-teal-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700">Technical Intern Training</a>, including transition provisions</td></tr><tr><th scope="row" class="px-4 py-3 font-medium text-slate-950">Three-year employment development beginning from April 2027</th><td class="px-4 py-3"><a href="/articles/employment-for-skill-development-system" class="font-medium text-teal-800 underline decoration-teal-300 underline-offset-4 hover:text-teal-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700">Employment for Skill Development</a> in a covered field</td></tr><tr><th scope="row" class="px-4 py-3 font-medium text-slate-950">Direct work after meeting field skill and language requirements</th><td class="px-4 py-3"><a href="/articles/specified-skilled-worker-status" class="font-medium text-teal-800 underline decoration-teal-300 underline-offset-4 hover:text-teal-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700">Specified Skilled Worker</a></td></tr><tr><th scope="row" class="px-4 py-3 font-medium text-slate-950">Ordinary specialized or other work</th><td class="px-4 py-3"><a href="/articles/choosing-a-work-status-and-coe" class="font-medium text-teal-800 underline decoration-teal-300 underline-offset-4 hover:text-teal-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700">Compare the activity-based work statuses</a></td></tr></tbody></table></div>"`;

exports[`article component extraction markup > preserves training ja parent markup byte for byte 1`] = `"<div lang="ja" class="mt-6 overflow-x-auto rounded-2xl border border-slate-200"><table class="min-w-full border-collapse text-left text-sm"><caption class="sr-only">活動内容から最初に確認する研修・就学・就労経路</caption><thead class="bg-slate-100 text-slate-950"><tr><th scope="col" class="min-w-64 px-4 py-3 font-semibold">予定する活動</th><th scope="col" class="min-w-56 px-4 py-3 font-semibold">最初に確認する経路</th></tr></thead><tbody class="divide-y divide-slate-200 bg-white text-slate-700"><tr><th scope="row" class="px-4 py-3 font-medium text-slate-950">無報酬の日本文化の学習または研究</th><td class="px-4 py-3"><a href="/articles/cultural-activities-visa" class="font-medium text-teal-800 underline decoration-teal-300 underline-offset-4 hover:text-teal-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700">文化活動</a></td></tr><tr><th scope="row" class="px-4 py-3 font-medium text-slate-950">要件を満たす学校での教育</th><td class="px-4 py-3"><a href="/articles/student-visa-and-certificate-of-eligibility" class="font-medium text-teal-800 underline decoration-teal-300 underline-offset-4 hover:text-teal-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700">留学</a></td></tr><tr><th scope="row" class="px-4 py-3 font-medium text-slate-950">受入先による体系的な非雇用研修</th><td class="px-4 py-3"><a href="/articles/training-visa" class="font-medium text-teal-800 underline decoration-teal-300 underline-offset-4 hover:text-teal-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700">研修</a></td></tr><tr><th scope="row" class="px-4 py-3 font-medium text-slate-950">現在有効な認定済みの技能実習計画</th><td class="px-4 py-3"><a href="/articles/technical-intern-training-status" class="font-medium text-teal-800 underline decoration-teal-300 underline-offset-4 hover:text-teal-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700">技能実習</a>（移行措置を含む）</td></tr><tr><th scope="row" class="px-4 py-3 font-medium text-slate-950">2027年4月から始まる3年間の雇用による育成</th><td class="px-4 py-3"><a href="/articles/employment-for-skill-development-system" class="font-medium text-teal-800 underline decoration-teal-300 underline-offset-4 hover:text-teal-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700">育成就労</a>（対象分野）</td></tr><tr><th scope="row" class="px-4 py-3 font-medium text-slate-950">分野別の技能・日本語要件を満たした後の直接雇用</th><td class="px-4 py-3"><a href="/articles/specified-skilled-worker-status" class="font-medium text-teal-800 underline decoration-teal-300 underline-offset-4 hover:text-teal-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700">特定技能</a></td></tr><tr><th scope="row" class="px-4 py-3 font-medium text-slate-950">通常の専門職その他の就労</th><td class="px-4 py-3"><a href="/articles/choosing-a-work-status-and-coe" class="font-medium text-teal-800 underline decoration-teal-300 underline-offset-4 hover:text-teal-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700">活動内容に基づく就労資格を比較</a></td></tr></tbody></table></div>"`;
