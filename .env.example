# Values are printed by `npm run supabase:status` after the local stack starts.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Prefer a current secret key when the environment provides one. The local CLI currently prints a legacy service-role key.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Social providers remain hidden until their local credentials and callbacks are deliberately configured.
NEXT_PUBLIC_SUPABASE_GOOGLE_AUTH_ENABLED=false
NEXT_PUBLIC_SUPABASE_APPLE_AUTH_ENABLED=false

# Transactional email is fail-closed. Development tests use injected fakes and send no real messages.
EMAIL_DELIVERY_ENABLED=false
EMAIL_PROVIDER=amazon-ses
AWS_REGION=
EMAIL_FROM_NAME=Nihonest
EMAIL_FROM_ADDRESS=
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
